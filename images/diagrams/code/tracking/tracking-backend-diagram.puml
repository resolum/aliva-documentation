LowBatteryAlertCommandService .. N_RulesReport
ActuatorActionCommandService .. N_RulesReport
ActuatorActionCommandService .. N_RulesEach
EdgeConnectionCommandService .. N_RulesConnection
HelpRequestQueryService .. N_RulesQueries
LowBatteryAlertQueryService .. N_RulesQueries
