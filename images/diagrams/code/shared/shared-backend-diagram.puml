@startuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package alivia.platform.shared {

  package domain.model.aggregate {

    class AuditableAbstractAggregateRoot {
      - id : Long
      - createdAt : LocalDateTime
      - updatedAt : LocalDateTime
      + addDomainEvent(event : Object) : void
    }

    class AuditableMongoAggregateRoot {
      - id : String
      - createdAt : LocalDateTime
      - updatedAt : LocalDateTime
      + addDomainEvent(event : Object) : void
    }
  }

  package domain.model.valueobject {

    class EmailAddress <<record>> {
      - emailAddress : String
    }

    enum EmailTemplate {
      WELCOME
      RESET_PASSWORD
    }

    class Photo <<record>> {
      - photoUrl : String
      - photoPublicId : String
    }

    class PersonProfileId <<record>> {
      - personProfileId : Long
    }

    class UserId <<record>> {
      - userId : Long
    }

    class BusinessId <<record>> {
      - businessId : Long
    }

    class TimeRange <<record>> {
      - start : LocalTime
      - end : LocalTime
      + contains(time : LocalTime) : boolean
      + contains(other : TimeRange) : boolean
      + overlaps(other : TimeRange) : boolean
      + duration() : Duration
    }

     class PhoneNumber <<Record>> {
          + PhoneNumber(String phoneNumber)
        }
  }

  package domain.model.entities {

    class AuditableModel {
      - id : Long
      - createdAt : LocalDateTime
      - updatedAt : LocalDateTime
    }
  }
}
@enduml