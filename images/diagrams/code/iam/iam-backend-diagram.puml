package alivia.platform.Iam {

  package "domain.model.aggregates" #F4F9FE {

    class User #DCEBFA {
      - EmailAddress emailAddress
      - HashedPassword password
      - boolean temporaryPassword
      - AccountType accountType
      - AccountStatus status
      - Set<Role> roles
      - PasswordToken passwordToken
      - boolean emailVerified
      - VerificationCode verificationCode
      --
      + {static} signUp(EmailAddress emailAddress, HashedPassword password, Role role,
      \t VerificationCode code, String rawCode) : User
      + {static} invited(EmailAddress emailAddress, Role caregiverRole, PasswordToken token) : User
      + {static} corporate(EmailAddress emailAddress, HashedPassword temporaryPassword, Role role) : User
      + replaceCorporateRole(Role role)
      + hasRole(Roles role) : boolean
      + verifyEmail(String codeHash, LocalDateTime now)
      + renewVerificationCode(VerificationCode code, String rawCode)
      + issuePasswordToken(PasswordToken token)
      + definePassword(String tokenHash, HashedPassword password, LocalDateTime now)
      + changeTemporaryPassword(HashedPassword password)
      + changePassword(HashedPassword password)
      + block()
      + unblock()
      + deactivate()
      + canSignIn() : boolean
      + hasDefinedPassword() : boolean
      + isEmailVerified() : boolean
    }

    note bottom of User
      <b>User</b>: una cuenta de Alivia (correo + contraseña).
      Las fábricas ponen el tipo de cuenta según el rol.
      --
      <b>Fábricas</b>
      signUp: cuenta PENDING con la contraseña del usuario
      (administrador o familiar) y un código de verificación;
      registra EmailVerificationRequestedEvent.
      invited y corporate nacen con emailVerified = true
      al activarse: el enlace o la contraseña temporal
      llegaron a su correo.
      invited: cuenta PERSONAL PENDING, sin contraseña, con
      ROLE_CAREGIVER y un token SETUP.
      corporate: cuenta CORPORATE PENDING con contraseña
      temporal (temporaryPassword = true) y el rol del
      empleado. Registra CorporateAccountCreatedEvent.
      --
      <b>Invariantes</b>
      Cada rol es de su tipo de cuenta
      (RoleNotAllowedForAccountType). Una cuenta PERSONAL tiene
      un solo rol: ROLE_RELATIVE o ROLE_CAREGIVER.
      verifyEmail: el código coincide (InvalidVerificationCode)
      y no venció (VerificationCodeExpired); el correo no
      estaba verificado (EmailAlreadyVerified). Deja la
      cuenta ACTIVE y borra el código.
      renewVerificationCode: solo si el correo no está
      verificado (EmailAlreadyVerified); el código anterior
      deja de valer. Registra EmailVerificationRequestedEvent.
      replaceCorporateRole: solo cuentas CORPORATE con rol
      de empleado; reemplaza el anterior.
      issuePasswordToken: SETUP solo en una cuenta PENDING
      sin contraseña (regenera el enlace; el anterior deja
      de valer); RESET solo en una cuenta ACTIVE
      (AccountNotActive). Registra
      PasswordResetRequestedEvent si es RESET.
      definePassword: el token coincide y es del propósito
      esperado (InvalidPasswordToken), no venció
      (PasswordTokenExpired); deja la cuenta ACTIVE, borra
      el token y, si estaba PENDING, registra
      PasswordDefinedEvent.
      changeTemporaryPassword: la contraseña es temporal
      (PasswordNotTemporary); deja la cuenta ACTIVE y
      registra PasswordDefinedEvent.
      changePassword: cuenta ACTIVE (AccountNotActive).
      Transiciones (InvalidAccountStatusTransition):
      block: PENDING o ACTIVE a BLOCKED.
      unblock: BLOCKED a ACTIVE, o a PENDING si aún no
      completó su activación.
      deactivate: cualquiera a DEACTIVATED (final).
      canSignIn: ACTIVE (una cuenta ACTIVE siempre tiene el
      correo verificado y una contraseña definitiva).
    end note

    class DeviceCredential #DCEBFA {
      - Long edgeId
      - HashedPassword secret
      - CredentialStatus status
      --
      + DeviceCredential(Long edgeId, HashedPassword secret)
      + revoke()
      + isActive() : boolean
    }

    note bottom of DeviceCredential
      <b>DeviceCredential</b>: credencial con la que un edge
      se autentica ante la API. edgeId es el id del Edge
      de Assets (referencia por id).
      Constructor: ACTIVE. revoke: ACTIVE a REVOKED
      (DeviceCredentialRevoked si ya lo está).
      Un edge tiene una sola credencial ACTIVE
      (DeviceCredentialAlreadyExists).
      El secreto se genera en application, se muestra una
      sola vez para configurar el edge y se guarda hasheado.
    end note
  }

  package "domain.model.entities" #FDE7EE {

    class Role #FDE7EE {
      - Roles name
      --
      + Role(Roles name)
      + getStringName() : String
      + allowedFor(AccountType type) : boolean
      + isEmployeeRole() : boolean
      + {static} toRoleFromName(String name) : Role
    }

    note bottom of Role
      Entidad de catálogo, como en la referencia: una fila
      por cada valor de Roles, creada por SeedRolesCommand
      al iniciar la aplicación. No cambia.
      allowedFor: ROLE_ADMIN, ROLE_TECH,
      ROLE_SUBSCRIPTION_MANAGER y ROLE_CLEANING son
      CORPORATE; ROLE_RELATIVE y ROLE_CAREGIVER, PERSONAL.
      isEmployeeRole: TECH, SUBSCRIPTION_MANAGER o CLEANING.
    end note
  }

  package "domain.model.valueobjects" #F9F4FD {

    class HashedPassword <<Record>> #EADCF8 {
      + String value
      + HashedPassword(String value)
    }

    class PasswordToken <<Record>> #EADCF8 {
      + String tokenHash
      + TokenPurpose purpose
      + LocalDateTime expiresAt
      + PasswordToken(String tokenHash, TokenPurpose purpose, LocalDateTime expiresAt)
      + matches(String tokenHash, TokenPurpose purpose) : boolean
      + isExpired(LocalDateTime now) : boolean
    }

    note bottom of PasswordToken
      HashedPassword: contraseña o secreto ya hasheado por
      HashingService (application). No vacío.
      PasswordToken: enlace de un solo uso. El token real
      va en la url; aquí solo su hash.
      SETUP: definir la contraseña de una cuenta invitada;
      vence junto con la invitación (expiresAt de
      Assistance).
      RESET: recuperar la contraseña; la vigencia la fija
      application desde configuración.
    end note

    class VerificationCode <<Record>> #EADCF8 {
      + String codeHash
      + LocalDateTime expiresAt
      + VerificationCode(String codeHash, LocalDateTime expiresAt)
      + matches(String codeHash) : boolean
      + isExpired(LocalDateTime now) : boolean
    }

    note bottom of VerificationCode
      Código numérico que llega al correo al registrarse.
      Se guarda solo su hash. La vigencia la fija
      application desde configuración.
    end note

    enum Roles #EADCF8 {
      ROLE_ADMIN
      ROLE_TECH
      ROLE_SUBSCRIPTION_MANAGER
      ROLE_CLEANING
      ROLE_RELATIVE
      ROLE_CAREGIVER
    }

    enum AccountType #EADCF8 {
      PERSONAL
      CORPORATE
    }

    enum AccountStatus #EADCF8 {
      PENDING
      ACTIVE
      BLOCKED
      DEACTIVATED
    }

    enum TokenPurpose #EADCF8 {
      SETUP
      RESET
    }

    enum CredentialStatus #EADCF8 {
      ACTIVE
      REVOKED
    }
  }

