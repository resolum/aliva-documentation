  BackgroundColor #FFFDE7
  BorderColor #B8A800
}
skinparam package {
  BorderColor #888888
  FontStyle bold
}

legend left
  |= Color |= Significado |
  |<#DCEBFA>   | Aggregate |
  |<#FDE7EE>   | Entity (dentro de un aggregate) |
  |<#EADCF8>   | Value Object / Enum / componente embebido |
  |<#FFE4C4>   | Command (escritura) |
  |<#D5F0D8>   | Query (lectura) |
  |<#FFF3B0>   | Service (interface) |
  |<#CDEFF2>   | Event |
  |<#FFEBEE>   | Exception (dominio) |
endlegend

package alivia.platform.Hcm {

  package "domain.model.aggregates" #F4F9FE {

    class Employee #DCEBFA {
      - BusinessId businessId
      - UserId userId
      - StaffProfileId staffProfileId
      - EmployeeRole role
      - EmployeeStatus status
      - WorkSchedule workSchedule
      - ContractHistory contractHistory
      - VacationHistory vacationHistory
      --
      + Employee(BusinessId businessId, UserId userId, StaffProfileId staffProfileId, EmployeeRole role,
      \t WorkSchedule workSchedule, OperatingHours operatingHours,
      \t ContractPeriod firstContractPeriod, TypeOfContract firstContractType, LocalDate today)
      + belongsTo(BusinessId businessId) : boolean
      + changeRole(EmployeeRole role)
      + updateWorkSchedule(WorkSchedule workSchedule, OperatingHours operatingHours)
      + addContract(ContractPeriod period, TypeOfContract type, LocalDate today)
      + terminateContract(Long contractId)
      + scheduleVacation(VacationPeriod period, LocalDate today)
      + cancelVacation(Long vacationId, LocalDate today)
      + suspend()
      + reinstate()
      + terminate(LocalDate today)
      + currentContract(LocalDate today) : Optional<Contract>
      + isOnVacation(LocalDate today) : boolean
      + isTerminated() : boolean
    }

    note bottom of Employee
      <b>Invariantes de sus métodos</b>
      Constructor: estado ACTIVE; crea el primer Contract;
      el horario cumple OperatingHours; registra
      EmployeeHiredEvent.
      Ningún método modifica un empleado TERMINATED
      (EmployeeTerminated).
      Transiciones de estado (InvalidEmployeeStatusTransition):
      suspend: ACTIVE a SUSPENDED; registra EmployeeSuspendedEvent.
      reinstate: SUSPENDED a ACTIVE; registra
      EmployeeReinstatedEvent.
      terminate: ACTIVE o SUSPENDED a TERMINATED (estado
      final); termina el contrato vigente, cancela las
      vacaciones futuras y registra EmployeeTerminatedEvent.
      changeRole: registra EmployeeRoleChangedEvent si el rol
      cambia.
      updateWorkSchedule: cada turno cabe en OperatingHours
      (WorkScheduleOutsideOperatingHours).
      addContract: no empieza antes de today
      (InvalidContractPeriod) y no se cruza con otro contrato
      ACTIVE (ContractOverlap).
      terminateContract: el contrato existe (ContractNotFound)
      y está ACTIVE (ContractNotActive).
      scheduleVacation: no empieza antes de today
      (InvalidVacationPeriod), cae dentro de un contrato ACTIVE
      (VacationOutsideContract) y no se cruza con otra
      vacación SCHEDULED (VacationOverlap).
      cancelVacation: existe (VacationNotFound), está
      SCHEDULED y aún no empezó (VacationNotCancelable).
      isOnVacation(today): today dentro de una vacación
      SCHEDULED. VACATION se calcula; no es un estado guardado.
      <b>Sin contrato vigente</b> (vencido por fecha o
      terminado con terminateContract): el empleado sigue
      ACTIVE hasta que el administrador lo renueve
      (addContract) o lo cese (terminate). No hay proceso
      automático. currentContract(today) devuelve vacío y
      no se pueden programar vacaciones
      (VacationOutsideContract).
    end note
  }

  package "domain.model.entities" #FDE7EE {

    class Contract #FDE7EE {
      - Employee employee
      - ContractPeriod period
      - TypeOfContract type
      - ContractStatus status
      --
      + Contract(Employee employee, ContractPeriod period, TypeOfContract type)
      + terminate()
      + isActive() : boolean
      + isExpired(LocalDate today) : boolean
      + isCurrentOn(LocalDate date) : boolean
      + overlapsWith(ContractPeriod period) : boolean
    }

    note bottom of Contract
      Vive dentro de Employee: solo se modifica por su root.
      employee = referencia de vuelta a su root.
      Estado inicial ACTIVE. terminate: ACTIVE a TERMINATED
      (termina antes de su fecha de fin).
      isExpired(today): ACTIVE con endDate anterior a today;
      se calcula, no se guarda.
      isCurrentOn(date): ACTIVE y date dentro de su periodo.
      Terminar o dejar vencer un contrato no cambia el
      estado del empleado.
    end note

    class Vacation #FDE7EE {
      - Employee employee
      - VacationPeriod period
      - VacationStatus status
      --
      + Vacation(Employee employee, VacationPeriod period)
      + cancel(LocalDate today)
      + isOn(LocalDate date) : boolean
      + overlapsWith(VacationPeriod period) : boolean
    }

    note bottom of Vacation
      Vive dentro de Employee: solo se modifica por su root.
      Estado inicial SCHEDULED. cancel: SCHEDULED a
      CANCELLED, solo si aún no empezó (VacationNotCancelable).
      Una vacación que ya terminó sigue SCHEDULED: es el
      historial de lo que tomó.
    end note
  }

  package "domain.model.events" #DDF3F5 {

    class EmployeeHiredEvent #CDEFF2 {
      - Employee employee
      --
      + EmployeeHiredEvent(Employee employee)
      + getEmployeeId() : Long
      + getBusinessId() : Long
      + getUserId() : Long
      + getRole() : EmployeeRole
    }

    class EmployeeSuspendedEvent <<Record>> #CDEFF2 {
      + EmployeeSuspendedEvent(Long employeeId, Long businessId, Long userId)
    }

    class EmployeeReinstatedEvent <<Record>> #CDEFF2 {
      + EmployeeReinstatedEvent(Long employeeId, Long businessId, Long userId)
    }

    class EmployeeTerminatedEvent <<Record>> #CDEFF2 {
      + EmployeeTerminatedEvent(Long employeeId, Long businessId, Long userId)
    }

    class EmployeeRoleChangedEvent <<Record>> #CDEFF2 {
      + EmployeeRoleChangedEvent(Long employeeId, Long businessId, Long userId, EmployeeRole role)
    }

    note bottom of EmployeeHiredEvent
      Se registra en el constructor de Employee, cuando aún
      no hay id: getEmployeeId() lo lee del aggregate al
      publicarse, después del save.
      Los demás se registran sobre empleados ya guardados.
      Consumidores (ver Contextos externos): IAM bloquea,
      habilita, desactiva o cambia el rol de la cuenta
      corporativa; Communication avisa al empleado.
    end note
  }

  package "domain.model.valueobjects" #F9F4FD {

    class ContractHistory <<Embedded>> #EADCF8 {
      - List<Contract> contracts
      --
      + ContractHistory()
      + addContract(Employee employee, ContractPeriod period, TypeOfContract type) : Contract
      + getContractWithId(Long contractId) : Contract
      + currentContract(LocalDate today) : Optional<Contract>
      + hasActiveContractOverlapping(ContractPeriod period) : boolean
      + hasActiveContractCovering(VacationPeriod period) : boolean
      + terminateActiveContracts()
    }

    note bottom of ContractHistory
      <b>ContractHistory</b>
      Componente embebido en Employee que agrupa todos sus
      contratos, vigentes y pasados. No es un value object en
      sentido estricto: es mutable y contiene entidades con
      identidad. Se ubica en valueobjects porque se embebe en
      el aggregate.
      Constructor: lista vacía y mutable (new ArrayList).
      getContractWithId lanza ContractNotFound si no existe
      (nunca devuelve null).
    end note

    class VacationHistory <<Embedded>> #EADCF8 {
      - List<Vacation> vacations
      --
      + VacationHistory()
      + addVacation(Employee employee, VacationPeriod period) : Vacation
      + getVacationWithId(Long vacationId) : Vacation
      + hasScheduledVacationOverlapping(VacationPeriod period) : boolean
      + isOnVacation(LocalDate today) : boolean
      + cancelFutureVacations(LocalDate today)
    }

    note bottom of VacationHistory
      <b>VacationHistory</b>
      Componente embebido en Employee que agrupa sus
      vacaciones, como ContractHistory con los contratos.
      Lista vacía y mutable; getVacationWithId lanza
      VacationNotFound si no existe.
    end note

    class ContractPeriod <<Record>> #EADCF8 {
      + LocalDate startDate
      + LocalDate endDate
      + ContractPeriod(LocalDate startDate, LocalDate endDate)
      + contains(LocalDate date) : boolean
      + overlapsWith(ContractPeriod other) : boolean
    }

    class VacationPeriod <<Record>> #EADCF8 {
      + LocalDate startDate
      + LocalDate endDate
      + VacationPeriod(LocalDate startDate, LocalDate endDate)
      + contains(LocalDate date) : boolean
      + overlapsWith(VacationPeriod other) : boolean
      + days() : int
    }

    note bottom of ContractPeriod
      ContractPeriod y VacationPeriod: startDate y endDate
      obligatorios; endDate no anterior a startDate
      (InvalidContractPeriod, InvalidVacationPeriod).
      Los contratos siempre tienen fecha de fin.
    end note

    class WorkSchedule <<Record>> #EADCF8 {
      + List<WeeklyPeriod> shifts
      + WorkSchedule(List<WeeklyPeriod> shifts)
      + covers(DayOfWeek day, TimeRange range) : boolean
      + fitsWithin(OperatingHours operatingHours) : boolean
    }

    class OperatingHours <<Record>> #EADCF8 {
      + List<WeeklyPeriod> periods
      + OperatingHours(List<WeeklyPeriod> periods)
      + covers(WeeklyPeriod shift) : boolean
    }

    note bottom of WorkSchedule
      <b>WorkSchedule</b>
      Horario de trabajo semanal del empleado, fuera del
      contrato: un WeeklyPeriod (Shared) por cada bloque de
      días con el mismo turno.
      Ejemplo: Lun-Vie 08:00-16:00 y Sáb 08:00-12:00.
      Al menos un turno; ninguno cruza medianoche ni se cruza
      con otro (InvalidWorkSchedule).
      fitsWithin: cada turno está dentro del horario de
      atención de su negocio (OperatingHours).
      covers: un turno de ese día contiene todo el rango
      (lo usa Support al asignar una visita al técnico).
      isOnVacation(date) de Employee sirve para cualquier
      fecha, también la de una visita futura.
      --
      <b>OperatingHours</b>
      Horario de atención del Business del empleado (hoy,
      Alivia; por ejemplo, hasta las 22:00). Es la traducción
      que hace el ACL del BusinessHours de su BusinessProfile
      (Profiles), que ya no cruza medianoche.
    end note

    enum EmployeeStatus #EADCF8 {
      ACTIVE
      SUSPENDED
      TERMINATED
    }

    enum EmployeeRole #EADCF8 {
      TECH
      SUBSCRIPTION_MANAGER
      CLEANING
    }

    enum ContractStatus #EADCF8 {
      ACTIVE
      TERMINATED
    }

    enum TypeOfContract #EADCF8 {
      FULL_TIME
      PART_TIME
    }

    enum VacationStatus #EADCF8 {
      SCHEDULED
      CANCELLED
    }
  }

