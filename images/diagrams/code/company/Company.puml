@startuml
' Bounded Context: Company
' Solo capa domain: aggregates, value objects, commands, queries y services.
' Los parámetros de cada command se detallan en notas para que se lean mejor.
' El aggregate Business solo guarda BusinessProfileId (conecta con el contexto de Profile).
' Los nombres de las variables coinciden con los del contexto Profile.

skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontSize 12
skinparam defaultFontName Arial
skinparam roundCorner 8
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 11
skinparam stereotypeFontSize 10
skinparam padding 2
skinparam class {
  BackgroundColor White
  ArrowColor #444444
  BorderColor #333333
  BorderThickness 1.2
  AttributeFontSize 11
  StereotypeFontColor #555555
}
skinparam interface {
  BorderThickness 1.2
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
  FontSize 11
  BorderThickness 1
}
skinparam package {
  BorderColor #555555
  FontStyle bold
  FontSize 13
  BorderThickness 1.2
}


package alivia.platform.Company #F5F5F5 {

  package "domain.model.aggregates" #F4F9FE {

    class Business #DCEBFA {
      + BusinessProfileId businessProfileId
      + Administrator administrator
    }

    class Administrator #DCEBFA {
      + PersonProfileId personProfileId
      + UserId userId
      + EmailAddress backupPersonalEmail
    }
  }

  package "domain.model.valueobjects" #F9F4FD {

    class BusinessProfileId <<Record>> #EADCF8 {
      + BusinessProfileId(Long businessProfileId)
    }
  }

  package "domain.model.commands" #FFF8EE {

    class CreateBusinessCommand <<Record>> #FFE4C4 {
      + CreateBusinessCommand(...)
    }

    class UpdateBusinessCommand <<Record>> #FFE4C4 {
      + UpdateBusinessCommand(...)
    }

    class CreateAdministratorCommand <<Record>> #FFE4C4 {
      + CreateAdministratorCommand(...)
    }

    class UpdateAdministratorCommand <<Record>> #FFE4C4 {
      + UpdateAdministratorCommand(...)
    }
  }

  package "domain.model.queries" #F3FBF4 {

    class GetBusinessByAdministratorId <<Record>> #D5F0D8 {
      + GetBusinessByAdministratorId(Long administratorId)
    }

    class GetAdministratorById <<Record>> #D5F0D8 {
      + GetAdministratorById(Long administratorId)
    }

    class GetBusinessById <<Record>> #D5F0D8 {
      + GetBusinessById(Long id)
    }
  }

  package "domain.services" #FFFCEA {

    interface BusinessCommandServices #FFF3B0 {
      Long handle(CreateBusinessCommand command)
      Optional<Business> handle(UpdateBusinessCommand command)
    }

    interface BusinessQueryServices #FFF3B0 {
      Optional<Business> handle(GetBusinessByAdministratorId query)
      Optional<Business> handle(GetBusinessById query)
    }

    interface AdministratorCommandServices #FFF3B0 {
      Long handle(CreateAdministratorCommand command)
      Optional<Administrator> handle(UpdateAdministratorCommand command)
    }

    interface AdministratorQueryServices #FFF3B0 {
      Optional<Administrator> handle(GetAdministratorById query)
    }
  }

  package "domain.model.exceptions" #FFEBEE {

    class BusinessNotFound <<Exception>> #FFCDD2 {
      + BusinessNotFound()
    }

    class AdministratorNotFound <<Exception>> #FFCDD2 {
      + AdministratorNotFound()
    }

    class AdministratorAlreadyExists <<Exception>> #FFCDD2 {
      + AdministratorAlreadyExists()
    }

    class BusinessAlreadyExistsForAdministrator <<Exception>> #FFCDD2 {
      + BusinessAlreadyExistsForAdministrator()
    }

    class BackupPersonalEmailAlreadyExists <<Exception>> #FFCDD2 {
      + BackupPersonalEmailAlreadyExists()
    }
  }
}

' ---------- FLUJO DE ESCRITURA (naranja) ----------
BusinessCommandServices -[#E67E22]-> CreateBusinessCommand : "1. recibe"

BusinessCommandServices -[#E67E22]-> UpdateBusinessCommand : "1. recibe"

AdministratorCommandServices -[#E67E22]-> CreateAdministratorCommand : "1. recibe"

AdministratorCommandServices -[#E67E22]-> UpdateAdministratorCommand : "1. recibe"

' ---------- FLUJO DE LECTURA (verde) ----------
BusinessQueryServices -[#2E8B57]-> GetBusinessByAdministratorId : "recibe"
BusinessQueryServices -[#2E8B57]-> GetBusinessById : "recibe"

AdministratorQueryServices -[#2E8B57]-> GetAdministratorById : "recibe"

' ---------- RESULTADO SOBRE EL AGGREGATE (azul) ----------
BusinessCommandServices -[#1F6FB2]-> Business : "2. crea / actualiza"
AdministratorCommandServices -[#1F6FB2]-> Administrator : "2. crea / actualiza"
BusinessQueryServices -[#2E8B57]-> Business : "devuelve"
AdministratorQueryServices -[#2E8B57]-> Administrator : "devuelve"

' ---------- COMPOSICIÓN DEL AGGREGATE (morado) ----------
Business *-[#7E57C2]- BusinessProfileId : "referencia al perfil"

Business "1" -[#1F6FB2]-> "1" Administrator : "gestionado por"

' ---------- PARÁMETROS DE LOS CONSTRUCTORES (notas fuera del package) ----------
note as N_CreateBusiness
  **CreateBusinessCommand**
  --Identidad del negocio--
  byte[] photoData
  String photoFileName
  String businessName
  String legalName
  Long ruc
  String mainActivity
  String description
  --Información de contacto--
  String emailAddress
  String phoneNumber
  --Ubicación corporativa (Google Maps)--
  String formattedAddress
  Double latitude
  Double longitude
  String placeId
  --Información para clientes--
  String businessHours
  String supportEmail
  String emergencyPhone
  String whatsappNum
  String slogan
  --Relaciones--
  Long administratorId
end note

note as N_UpdateBusiness
  **UpdateBusinessCommand**
  Long businessId
  --Identidad del negocio--
  byte[] photoData
  String photoFileName
  String businessName
  String legalName
  String mainActivity
  String description
  --Información de contacto--
  String emailAddress
  String phoneNumber
  --Información para clientes--
  String businessHours
  String supportEmail
  String emergencyPhone
  String whatsappNum
  String slogan
  ..
  No incluye ruc ni la ubicación corporativa
  (son inmutables). Solo el Administrador
  General puede modificar legalName
  (Ley N° 29733). Los estados "Vigente y
  Validado" y "Activo Habido" los determina
  el sistema (SUNAT/SUNARP), no el command.
end note

note as N_CreateAdministrator
  **CreateAdministratorCommand**
  --Credenciales--
  String emailAddress
  String password
  --Información personal--
  byte[] photoData
  String photoFileName
  String firstName
  String lastName
  String dni
  String phoneNumber
  --Información de contacto--
  String backupPersonalEmail  // opcional
  --Relaciones--
  Long personProfileId
  Long userId
end note

note as N_UpdateAdministrator
  **UpdateAdministratorCommand**
  Long administratorId
  --Información personal--
  byte[] photoData
  String photoFileName
  String firstName
  String lastName
  String phoneNumber
  --Información de contacto--
  String backupPersonalEmail  // opcional
end note

CreateBusinessCommand .. N_CreateBusiness
UpdateBusinessCommand .. N_UpdateBusiness
CreateAdministratorCommand .. N_CreateAdministrator
UpdateAdministratorCommand .. N_UpdateAdministrator

note bottom of Administrator
  PersonProfileId y UserId son value objects
  del contexto Shared (alivia.platform.shared).
  backupPersonalEmail se guarda aquí; los demás
  datos personales van a PersonProfile (Profile)
  y password al contexto de iam.
end note

note bottom of Business
  Los datos del negocio se guardan en BusinessProfile
  (contexto Profiles), referenciado solo por BusinessProfileId.
end note

@enduml
