note as N_CreateRelative
  <b>CreateRelativeCommand</b>
  --
  Long businessId  // BusinessId: Business del contexto Company
  // credenciales (IAM)
  String emailAddress  // también es el email del PersonProfile
  String password  // oculto en toString() para que no llegue a los logs
  // datos del PersonProfile (Profiles)
  byte[] photoData
  String photoFileName
  String phoneNumber
  String firstName
  String lastName
  String dni
  LocalDate birthDate
  --
  <b>Valida</b>
  El negocio existe en Company (BusinessNotFound).
  Profiles (ACL) valida que el email y el dni no estén
  registrados (ExistsPersonProfileByEmailAddressQuery,
  ExistsPersonProfileByDniQuery; EmailAddressAlreadyExists,
  DniAlreadyExists) y crea el PersonProfile con estos datos;
  devuelve el personProfileId.
  Los perfiles nunca se buscan por email ni por dni: solo por id.
  IAM (ACL) crea el usuario con emailAddress + password y
  devuelve el userId, que se guarda en el Relative.
end note

note as N_CreateAssistedPerson
  <b>CreateAssistedPersonCommand</b>
  --
  Long relativeId
  // datos del PersonProfile (Profiles)
  String emailAddress  // opcional
  byte[] photoData
  String photoFileName
  String phoneNumber
  String firstName
  String lastName
  String dni
  LocalDate birthDate
  --
  <b>Valida</b>
  El Relative existe (RelativeNotFound).
  Profiles (ACL) valida que el dni y, si viene, el email no
  estén registrados (ExistsPersonProfileByDniQuery,
  ExistsPersonProfileByEmailAddressQuery; DniAlreadyExists,
  EmailAddressAlreadyExists) y crea el PersonProfile con estos
  datos; devuelve el personProfileId.
  Los perfiles nunca se buscan por email ni por dni: solo por id.
  Queda gestionada por ese Relative.
end note

note as N_CreateCareActivity
  <b>CreateCareActivityCommand</b>
  --
  Long relativeId
  Long assistedPersonId
  CareActivityType type
  String title
