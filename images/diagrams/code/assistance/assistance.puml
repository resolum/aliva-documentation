  package "domain.model.valueobjects" #F9F4FD {

    class Schedule <<Record>> #EADCF8 {
      - ScheduleType type
      - LocalDate date
      - TimeRange timeRange
      - WeeklyPeriod weeklyPeriod
      --
      + {static} oneTime(LocalDate date, TimeRange timeRange) : Schedule
      + {static} weekly(WeeklyPeriod weeklyPeriod) : Schedule
      + occursOn(LocalDate date) : boolean
      + effectiveTimeRange() : TimeRange
      + overlapsWith(Schedule other) : boolean
    }

    note bottom of Schedule
      <b>Schedule</b> (propio de Assistance)
      ONE_TIME: date y timeRange obligatorios, weeklyPeriod nulo.
      WEEKLY: weeklyPeriod obligatorio (al menos un día),
      date y timeRange nulos.
      "Lunes a domingo" = WEEKLY con 7 días.
      "Una vez por semana" = WEEKLY con 1 día.
      occursOn: ONE_TIME compara la fecha; WEEKLY delega en
      weeklyPeriod.
      effectiveTimeRange: el rango de cualquiera de las dos
      formas (es el que se copia al ActivityLog).
    end note

    class AgendaItem <<Record>> #EADCF8 {
      + AgendaItem(...)
    }

    note bottom of AgendaItem
      <b>AgendaItem</b>
      Modelo de lectura calculado (no se persiste).
      Cruza las asignaciones ACTIVE que ocurren ese día
      con los ActivityLog y la hora actual.
      No tiene services propios: no es un aggregate. Sus
      queries las resuelve CareActivityQueryService.
      GetAgendaByAssistedPersonId: toda la persona (familiar
      y cuidadores). GetAgendaByCaregiverId: solo lo asignado
      a ese cuidador.
      --
      Long careActivityId
      Long assignmentId
      String title
      CareActivityType type
      LocalDate date
      TimeRange timeRange
      Long caregiverId
      boolean recurring
      OccurrenceStatus status
    end note

    enum ScheduleType <<Enum>> #EADCF8 {
      ONE_TIME
      WEEKLY
    }

    enum CareActivityType <<Enum>> #EADCF8 {
      MEDICATION
      BATH
      MEAL
      EXERCISE
      THERAPY
      APPOINTMENT
      OTHER
    }

    enum ActivityStatus <<Enum>> #EADCF8 {
      ACTIVE
      INACTIVE
    }

    enum ActivityLogStatus <<Enum>> #EADCF8 {
      COMPLETED
      CANCELLED
      MISSED
    }

    enum OccurrenceStatus <<Enum>> #EADCF8 {
      SCHEDULED
      IN_PROGRESS
      OVERDUE
      COMPLETED
      COMPLETED_LATE
      CANCELLED
      MISSED
    }

    enum InvitationStatus <<Enum>> #EADCF8 {
      PENDING
      ACCEPTED
      REVOKED
    }

    enum CaregiverStatus <<Enum>> #EADCF8 {
      ACTIVE
      REVOKED
    }
  }

