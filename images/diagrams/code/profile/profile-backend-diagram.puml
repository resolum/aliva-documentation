@startuml
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontSize 12
skinparam defaultFontName Arial
skinparam roundCorner 8
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 11
skinparam stereotypeFontSize 10
skinparam padding 2

skinparam class {
  BorderColor #333333
  ArrowColor #444444
  BackgroundColor #FFFFFF
  BorderThickness 1.2
  AttributeFontSize 11
  StereotypeFontColor #555555
  BackgroundColor<<Record>> #E3F2FD
  BorderColor<<Record>> #1565C0
  BackgroundColor<<Exception>> #FFEBEE
  BorderColor<<Exception>> #C62828
  BackgroundColor<<Command>> #FFF3E0
  BorderColor<<Command>> #EF6C00
  BackgroundColor<<Query>> #E8F5E9
  BorderColor<<Query>> #2E7D32
  BackgroundColor<<Aggregate>> #F3E5F5
  BorderColor<<Aggregate>> #6A1B9A
}

skinparam interface {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
  BorderThickness 1.2
}

skinparam package {
  BorderColor #555555
  FontStyle bold
  FontSize 13
  BorderThickness 1.2
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
  FontSize 11
  BorderThickness 1
}

package alivia.platform.Profiles #F5F5F5 {

  package domain.model.aggregates #F3E5F5 {

    abstract Profile <<Aggregate>> {
      + EmailAddress emailAddress
      + Photo photo
      + PhoneNumber phoneNumber
    }

    class PersonProfile <<Aggregate>> {
      - PersonName personName
      - Dni dni
      - BirthDate birthDate
    }

    class BusinessProfile <<Aggregate>> {
      - Ruc ruc
      - BusinessName businessName
      - String legalName
      - String description
      - String mainActivity
      - PhoneNumber whatsappNum
      - PhoneNumber emergencyPhone
      - BusinessHours businessHours
      - String slogan
      - EmailAddress supportEmail
      - Address address
    }
  }

  package domain.model.valueobjects #E3F2FD {

    class Ruc <<Record>> {
      + Ruc(Long ruc)
    }

    class BusinessName <<Record>> {
      + BusinessName(String businessName)
    }

    class BusinessHours <<Record>> {
      + List<OpeningPeriod> periods
      + isOpenAt(DayOfWeek day, LocalTime time): boolean
    }

    class OpeningPeriod <<Record>> {
      + Set<DayOfWeek> days
      + TimeRange range
    }

    class Dni <<Record>> {
      + Dni(String dni)
    }

    class BirthDate <<Record>> {
      + BirthDate(LocalDate birthDate)
    }

  }

  package domain.model.exceptions #FFEBEE {

    class BusinessNameAlreadyExists <<Exception>> {
      + BusinessNameAlreadyExists()
    }

    class PersonNameAlreadyExists <<Exception>> {
      + PersonNameAlreadyExists()
    }

    class RucAlreadyExists <<Exception>> {
      + RucAlreadyExists()
    }

    class DniAlreadyExists <<Exception>> {
      + DniAlreadyExists()
    }

    class PersonProfileNotFound <<Exception>> {
      + PersonProfileNotFound()
    }

    class BusinessProfileNotFound <<Exception>> {
      + BusinessProfileNotFound()
    }

    class InvalidBusinessHours <<Exception>> {
      + InvalidBusinessHours()
    }

    class PhoneNumberAlreadyExists <<Exception>> {
      + PhoneNumberAlreadyExists()
    }
  }

  package domain.model.commands #FFF3E0 {

    class CreatePersonProfileCommand <<Record>> <<Command>> {
      + CreatePersonProfileCommand(...)
    }

    class CreateBusinessProfileCommand <<Record>> <<Command>> {
      + CreateBusinessProfileCommand(...)
    }

    class UpdateBusinessProfileCommand <<Record>> <<Command>> {
      + UpdateBusinessProfileCommand(...)
    }

    class UpdatePersonProfileCommand <<Record>> <<Command>> {
      + UpdatePersonProfileCommand(...)
    }
  }

  package domain.model.queries #E8F5E9 {

    class GetPersonProfileByIdQuery <<Record>> <<Query>> {
      + GetPersonProfileByIdQuery(Long id)
    }

    class GetBusinessProfileByIdQuery <<Record>> <<Query>> {
      + GetBusinessProfileByIdQuery(Long id)
    }

    class GetAllPersonProfilesQuery <<Record>> <<Query>> {
      + GetAllPersonProfilesQuery()
    }

    class GetAllBusinessProfileQuery <<Record>> <<Query>> {
      + GetAllBusinessProfileQuery()
    }
  }

  package domain.services #FFFDE7 {

    interface PersonProfileCommandService {
      Long handle(CreatePersonProfileCommand command)
      Long handle(UpdatePersonProfileCommand command)
    }

    interface PersonProfileQueryService {
      Optional<PersonProfile> handle(GetPersonProfileByIdQuery query)
      Optional<PersonProfile> handle(GetAllPersonProfilesQuery query)
    }

    interface BusinessProfileQueryService {
      Optional<BusinessProfile> handle(GetBusinessProfileByIdQuery query)
      Optional<BusinessProfile> handle(GetAllBusinessProfileQuery query)
    }

    interface BusinessProfileCommandService {
      Long handle(CreateBusinessProfileCommand command)
      Long handle(UpdateBusinessProfileCommand command)
    }
  }

  Profile <|-- PersonProfile
  Profile <|-- BusinessProfile

  PersonProfile ..> domain.model.valueobjects.Dni
  PersonProfile ..> domain.model.valueobjects.BirthDate
  BusinessProfile ..> domain.model.valueobjects.BusinessName
  BusinessProfile ..> domain.model.valueobjects.Ruc
  BusinessProfile ..> BusinessHours
  BusinessHours ..> OpeningPeriod

  GetAllBusinessProfileQuery --> BusinessProfileQueryService
  GetBusinessProfileByIdQuery --> BusinessProfileQueryService

  GetAllPersonProfilesQuery --> PersonProfileQueryService
  GetPersonProfileByIdQuery --> PersonProfileQueryService

  CreateBusinessProfileCommand --> BusinessProfileCommandService
  UpdateBusinessProfileCommand --> BusinessProfileCommandService

  CreatePersonProfileCommand --> PersonProfileCommandService
  UpdatePersonProfileCommand --> PersonProfileCommandService
}

' ===== Notas con las variables de los comandos (fuera del package) =====

note as N_CreatePerson
  <b>CreatePersonProfileCommand</b>
  --
  String emailAddress
  byte[] photoData
  String photoFileName
  String phoneNumber
  String firstName
  String lastName
  String dni
  LocalDate birthDate
end note

note as N_UpdatePerson
  <b>UpdatePersonProfileCommand</b>
  --
  Long id
  String emailAddress
  byte[] photoData
  String photoFileName
  String phoneNumber
  String firstName
  String lastName
end note

note as N_CreateBusiness
  <b>CreateBusinessProfileCommand</b>
  --
  String emailAddress
  byte[] photoData
  String photoFileName
  String phoneNumber
  Long ruc
  String businessName
  String legalName
  String description
  String mainActivity
  String whatsappNum
  String emergencyPhone
  String businessHours  // texto/JSON de periodos
  String slogan
  String supportEmail
  String formattedAddress
  Double latitude
  Double longitude
  String placeId
end note

note as N_UpdateBusiness
  <b>UpdateBusinessProfileCommand</b>
  --
  Long id
  String emailAddress
  byte[] photoData
  String photoFileName
  String phoneNumber
  String businessName
  String legalName
  String description
  String mainActivity
  String whatsappNum
  String emergencyPhone
  String businessHours  // texto/JSON de periodos
  String slogan
  String supportEmail
end note

CreatePersonProfileCommand .. N_CreatePerson
UpdatePersonProfileCommand .. N_UpdatePerson
CreateBusinessProfileCommand .. N_CreateBusiness
UpdateBusinessProfileCommand .. N_UpdateBusiness

note bottom of Profile
  Address (solo BusinessProfile), PhoneNumber, EmailAddress
  y Photo son value objects del contexto Shared.
end note

note as N_BusinessHours
  <b>BusinessHours</b>
  Horario de atención de un negocio. Agrupa una
  lista de OpeningPeriod, uno por cada bloque
  de días con el mismo horario.
  En los comandos llega como String
  (texto/JSON) y se convierte a este value object.
  --
  <b>isOpenAt(day, time)</b>
  Indica si el negocio está abierto en ese día
  y a esa hora, revisando todos sus periodos.
end note

note as N_OpeningPeriod
  <b>OpeningPeriod</b>
  Un bloque de atención: un conjunto de días
  (<i>days</i>) que comparten el mismo rango de horas
  (<i>range</i>, un TimeRange de Shared).
  --
  Ejemplo:
  Lun–Vie 09:00–18:00
  Sáb 09:00–13:00
  (son dos OpeningPeriod dentro de BusinessHours)
end note

BusinessHours .. N_BusinessHours
OpeningPeriod .. N_OpeningPeriod

@enduml
