@startuml
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontSize 12
skinparam class {
  BorderColor #333333
  ArrowColor #444444
}

package alivia.platform.Profiles {

  package Profiles.domain.aggregates {

    abstract Profile {
      + EmailAddress emailAddress
      + Photo photo
      + PhoneNumber phoneNumber
    }

    class PersonProfile {
      - PersonName personName
      - Dni dni
      - BirthDate birthDate
    }

    class BusinessProfile {
      - Ruc ruc
      - BusinessName businessName
      - String description
      - String mainActivity
      - PhoneNumber whatsappNum
      - BusinessHours businessHours
      - String slogan
      - EmailAddress supportEmail
      - Address address
    }
  }

  package Profiles.domain.valueobjects {

    class Ruc <<Record>> {
      + Ruc(Long ruc)
    }

    class BusinessName <<Record>> {
      + BusinessName(String businessName)
    }

    class BusinessHours <<Record>> {
      + List<OpeningPeriod> periods
      + isOpenAt(DayOfWeek day, LocalTime time): boolean
    }

    class OpeningPeriod <<Record>> {
      + Set<DayOfWeek> days
      + TimeRange range
    }
  }

  Profile <|-- PersonProfile
  Profile <|-- BusinessProfile


}


@enduml